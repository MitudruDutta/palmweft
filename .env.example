# Palmweft local configuration. Copy this file to .env in the repository root.
# The server loads .env; browser bundles must never contain its credentials.

# Models: an empty key selects labelled fixture responses without model requests.
# Obtain a live Meta Model API key from https://dev.meta.ai.
MODEL_API_KEY=
# Identifier used for chat and image-understanding requests.
MUSE_MODEL=muse-spark-1.3
# Optional API origin; defaults to https://api.meta.ai/v1.
MUSE_API_BASE=
# Optional reasoning level: minimal, low, medium, high, xhigh, or max.
MUSE_REASONING_EFFORT=
# Identifier used for microphone transcription.
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Choose live or fixture explicitly, or leave empty to select from the key.
MODEL_MODE=
# Delay applied to fixture responses, in milliseconds.
FIXTURE_DELAY_MS=300

# Browser connections over HTTPS/WSS. LAN devices must trust the certificate.
# Development certificates are generated under apps/server/.certs.
HTTPS_HOST=0.0.0.0
HTTPS_PORT=8443
# HTTP/WS is unencrypted. Restrict it to a trusted LAN or bind 127.0.0.1.
# USB debugging can forward the port with adb reverse tcp:8787 tcp:8787.
HTTP_HOST=0.0.0.0
HTTP_PORT=8787
# Optional hostname or IP advertised by pairing links; defaults to a LAN IPv4.
PUBLIC_HOST=

# CE_* names are stable configuration keys shared by Palmweft's clients.
# Set 1 to approve the initial pairing automatically when the registry is empty.
CE_TRUST_FIRST_DEVICE=
# Set 0 to remove the owner privileges normally granted to loopback callers.
CE_TRUST_LOOPBACK=
# Set 0 to disable pairing approvals through the server's terminal.
CE_CONSOLE_APPROVE=
# Private data directory; defaults to apps/server/.data. Keep it outside builds.
CE_DATA_DIR=
# Set 1 to allow LAN replay of uploaded takes. Local replay works without it.
CE_SHARE_TAKES=

# Fixture recordings: live recording is opt-in and may retain private images.
# Review captured material before adding it to source control.
MUSE_RECORD=
# Set 0 to use scripted fixtures instead of the existing response recordings.
MUSE_REPLAY=
# Optional recording directory; defaults to apps/server/fixtures/recorded.
MUSE_RECORD_DIR=

# Runtime coding: empty or 1 uses the agent; 0 selects the legacy setup harness.
# Agent generation always requires an explicit request from the operator.
CE_AGENT=
# Set 1 for demo setup conveniences. This does not pre-wire interactions.
CE_DEMO=
# Set 1 only for deliberate prefetch rehearsals; ordinary demos leave this empty.
CE_PREFETCH=
# Gimbal bridge: empty disables it; web uses Chrome on port 8799; mock simulates
# a gimbal; ble uses the local Bluetooth helper.
CE_OSMO=
# Optional private agent workspace; defaults to CE_DATA_DIR/muse-agent.
CE_AGENT_WORKSPACE=

# Discovery: optional comma-separated object nouns for SAM scan prompts.
# Use device/object categories rather than prompts identifying people.
CE_SCAN_PROMPTS=
# Set 1 to learn all IR codes. Normally only unknown/Koizumi lights need learning.
CE_IR_LEARN=
# Set 0 to disable the macOS executor for system volume, Music, and speech.
CE_MAC_LOCAL=
# Set 1 for silent automation. Volume changes remain in memory, and recorded
# speech fixtures are identified as recordings in acknowledgements and evidence.
CE_MAC_SILENT=

# Optional Nature Remo IR bridge. Discovery alone never transmits IR commands.
# Supply a trusted LAN address or host:port to skip mDNS discovery.
REMO_HOST=
# Set 1 to discover _remo._tcp when no explicit REMO_HOST is configured.
CE_REMO=
# Set 1 only after approving IR transmission. Sends remain at least 1 second apart.
REMO_SEND=
